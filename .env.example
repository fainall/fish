# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtén estas credenciales en: https://supabase.com → Tu proyecto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
# 1. Crea un proyecto en: https://console.cloud.google.com
# 2. APIs y servicios → Credenciales → Crear ID de cliente OAuth
# 3. Para dev con Expo Go, redirect URI: https://auth.expo.io/@TU_USUARIO/aquamanager
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=     (para compilación App Store)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID= (para compilación Google Play)

# ── Sentry (opcional — crash reporting) ───────────────────────────────────────
# SENTRY_DSN=https://xxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
